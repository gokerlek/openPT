# Axon Fit — sunucu ortam değişkenleri (Vercel → Settings → Environment Variables)
# Hiçbiri NEXT_PUBLIC_ ile başlamaz: hepsi yalnız sunucuda okunur, tarayıcıya inmez.

# GitHub kullanıcı adın (uygulama ve danışan repolarının sahibi)
GITHUB_OWNER=

# Veri repo'sunun adı: uygulama ayarları, egzersizlerin, danışan kimlik listesi.
# Kodun fork'undan AYRI bir ad olmalı: açık bir repo'nun fork'u gizli yapılamaz, veri
# oraya yazılırsa herkese açık olur. Kurulum bu repo'yu özel olarak kendisi açar.
APP_REPO=axon-fit-data

# --- GitHub erişimi: iki yoldan BİRİ -------------------------------------------
# Uygulama yalnız APP_REPO'ya ve "client-" ile başlayan repolara dokunur (SPEC §9.2);
# güncellemelerde ayrıca AXON_CODE_REPO'ya.

# 1) GitHub uygulaması (yeni kurulumlar; "kur" komutu ve /install sihirbazı bunu yazar).
#    İkisi de doluysa bu mod seçilir ve GITHUB_TOKEN kullanılmaz.
#    İzinler: Administration, Contents, Actions, Workflows yazma; Metadata okuma. Webhook kapalı.
#    Kurulum "All repositories" erişimiyle yapılmalı (yeni danışan repoları kendiliğinden görünsün).
GITHUB_APP_ID=
# .pem dosyasının tamamı. Tek satırlık alanlarda satır sonlarını \n yaz:
# -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=
# İsteğe bağlı: boşsa GITHUB_OWNER hesabındaki kurulum bulunur.
GITHUB_APP_INSTALLATION_ID=

# 2) Kişisel anahtar (eski kurulumlar): danışan repolarını oluşturup silebilen classic token
#    (repo, delete_repo, workflow). Yalnız bu iş için üret, süreli olsun.
GITHUB_TOKEN=

# GitHub ile giriş (PT'nin giriş yöntemi)
# GitHub uygulamasında: uygulamanın kendi Client ID / Client Secret değerleri
#   (Callback URL: https://<alan-adin>/api/auth/github/callback). Repo açma/silme bu girişle yapılır.
# Kişisel anahtar yolunda: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: https://<alan-adin>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Oturum çerezlerini imzalayan sır: openssl rand -base64 32
# GitHub uygulaması modunda PT'nin GitHub kullanıcı anahtarının çerezi de bundan türetilen
# anahtarla şifrelenir; değişirse PT GitHub ile yeniden girer.
AUTH_SECRET=

# YEDEK giriş yolu (isteğe bağlı): e-posta kodu. Boş bırakılırsa bu yol kapalıdır.
# Amacı, OAuth ayarı bozulursa uygulamana girememe durumuna düşmemek.
PT_EMAIL=
RESEND_API_KEY=

# İsteğe bağlı: Resend üzerinde doğrulanmış gönderici adresi
# RESEND_FROM="Axon Fit <giris@alanadin.com>"

# Kod güncelleme paneli: kendi kod repon (veri repo'su değil).
# Vercel Production Branch'i bu repo'nun default branch'i olmalı.
AXON_CODE_REPO=

# AI sonraki aşamada eklenecek; şimdilik isteğe bağlı hazırlık anahtarı.
GEMINI_API_KEY=

# Vercel üretim dalı; otomatik güncelleme için repo'nun default branch'i olmalı.
AXON_CODE_BRANCH=main
